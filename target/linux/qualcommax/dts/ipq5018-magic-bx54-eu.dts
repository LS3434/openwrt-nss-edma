/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-nss.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "H3C Magic BX54 EU";
	compatible = "h3c,magic-bx54-eu", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		label-mac-device = &gmac0;
		led-boot = &led_status_blue;
		led-failsafe = &led_status_red;
		led-running = &led_status_blue;
		led-upgrade = &led_status_red;
	};

	chosen {
		/* the stock U-Boot passes loglevel=3, which hides the boot log on the console */
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M loglevel=7";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		/* swapped compared to the RC3000 (stock DT: reset 38, wps 27) */
		button-reset {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		button-wps {
			label = "wps";
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status_red: led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <0>;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};

		led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <1>;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};

		led-2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		};

		led-3 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <3>;
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: led-4 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <0>;
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led-5 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
		};

		led-6 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		led-7 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
		};

		led-8 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* the stock TZ takes 4 MiB here (upstream reserves 2 MiB) */
&tz_region {
	reg = <0x0 0x4ac00000 0x0 0x400000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	/* ESMT F50D1G41LB, 128 MiB */
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		/*
		 * Names come from SMEM: the SBL swaps rootfs/rootfs_1 after
		 * a slot switch. Wi-Fi calibration (ART 0x1000 IPQ5018,
		 * 0x26800 QCN9024) and the MACs (ASCII "ethaddr" in
		 * 0:appsblenv) are handled by 11-ath11k-caldata.
		 */
		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;
			};
		};
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

/* MAC0 -> IPQ5018 GE PHY (WAN) */
&gmac0 {
	status = "okay";

	label = "wan";
};

/* MAC1 -SGMII-> QCA8337 port 6 (stock: switch_cpu_bmp 0x40) */
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;
	/* H3C U-Boot leaves an MDIO divider the driver rejects */
	clock-frequency = <1562500>;

	/*
	 * Stock (pdt_data + firmware): switch_vlan ports '2 3 4 6t',
	 * port N -> PHY N-1. Port 1 / PHY 0 is not wired.
	 */
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	ethernet-switch@11 {
		compatible = "qca,qca8337";
		reg = <0x11>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* front panel, top to bottom: lan1 (port 3), lan2 (port 4), lan3 (port 2) */
			ethernet-port@2 {
				reg = <2>;
				label = "lan3";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan1";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "lan2";
				phy-handle = <&qca8337_3>;
			};

			ethernet-port@6 {
				reg = <6>;
				label = "cpu";
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio27", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-state {
		pins = "gpio25", "gpio26", "gpio28", "gpio31",
		       "gpio32", "gpio33", "gpio34", "gpio35", "gpio46";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};
};

&pcie0_phy {
	status = "okay";
};

/* QCN9024 (5 GHz, ath11k QCN9074) on the 2-lane PCIe */
&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,calibration-variant = "H3C-Magic-BX54-EU";
		};
	};
};

/*
 * IPQ5018 2.4 GHz. No QCN6122 on this board: the multi-PD WLAN.HK.2.7.0.1
 * image with only user PD 1 started, see ipq5018-qcn6122.dtsi. The 256 MiB
 * firmware mode leaves more RAM for NSS.
 */
&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,calibration-variant = "H3C-Magic-BX54-EU";
	qcom,ath11k-fw-memory-mode = <2>;
};
